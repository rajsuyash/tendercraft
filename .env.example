# Copy to .env and fill. App fails fast on missing required vars.
# Names only — never commit values.

# Supabase (web uses the publishable key; engine uses the secret/service key — never expose it to web)
NEXT_PUBLIC_SUPABASE_URL=          # Supabase project URL — web + engine
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # publishable key (sb_publishable_…) — web client
SUPABASE_SERVICE_ROLE_KEY=         # secret key (sb_secret_…) — engine, RLS-bypassing ops
SUPABASE_DB_URL=                   # direct Postgres URL — only if bypassing PostgREST
SUPABASE_ACCESS_TOKEN=             # PAT (sbp_…) — migrations via Management API (dev/CI only)
SUPABASE_ANON_JWT=                 # legacy anon JWT — auth admin + isolation tests (every API accepts it)
SUPABASE_SERVICE_JWT=              # legacy service_role JWT — auth admin API (new secret key is rejected there)

# LLM
ANTHROPIC_API_KEY=                 # Claude API — pipeline components (extractor/drafter/matcher/translator)

# OCR — TODO: choose provider (Document AI vs Textract vs Surya), then replace with its real vars
OCR_PROVIDER=                      # e.g. "documentai" | "textract" — gates A-FR1/A-FR6
OCR_API_CREDENTIALS=               # provider credential reference (path or key name)

# Service wiring
ENGINE_URL=                        # web → engine base URL (http://localhost:8000 in dev)
ENGINE_JWT_SECRET=                 # engine validates Supabase JWTs (Supabase JWT secret)

# Storage
DOCUMENTS_BUCKET=tender-documents  # Supabase Storage bucket for tender packages + library docs

# Optional
SENTRY_DSN=                        # error reporting (leave empty to disable)


# ─────────────────────────────────────────────────────────────────────────────
# TenderCraft EVALUATE (government-side product) — PRD §9, ENV-1..8
#
# A SEPARATE Supabase project. NEXT_PUBLIC_EVAL_SUPABASE_URL must never equal
# NEXT_PUBLIC_SUPABASE_URL above — tools/check-wall.sh fails the build if they match (F13-AC2).
# The model key is separate too, so usage and telemetry never commingle across the wall.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_EVAL_SUPABASE_URL=      # ENV-1 · evaluate project URL — MUST DIFFER from the bidder URL
NEXT_PUBLIC_EVAL_SUPABASE_ANON_KEY= # ENV-2 · publishable key, evaluate project (public by design)
EVAL_SUPABASE_SERVICE_JWT=          # ENV-3 · service JWT, evaluate project — ENGINE ONLY, never web
EVAL_MODEL_API_KEY=                 # ENV-4 · separate model credential (F13-AC3)
EVAL_ENGINE_URL=                    # ENV-5 · evaluate web → evaluate engine (http://localhost:8001 in dev)
EVAL_DOCUMENTS_BUCKET=eval-bids     # ENV-6 · Storage bucket for submitted bids
EVAL_VARIANCE_THRESHOLD=0.20        # ENV-7 · member spread that raises the consensus flag (fraction of max marks)
EVAL_DEFAULT_QUORUM=3               # ENV-8 · starting quorum at evaluation creation; per-evaluation value overrides

# ── Officer throughput extension — tendercraft-evaluate-throughput-PRD.md §9, ENV-9..15 ──
#
# No new vendor and no new credential appears below. OCR runs on EVAL_MODEL_API_KEY above
# (D7): only pages the existing quality gate already reports illegible are sent, and
# EVAL_OCR_MAX_PAGES_PER_TENDER is the ceiling that keeps a 300-page scan from becoming an
# unbounded bill. Exceeding it surfaces to the officer (F16-ERR1); it never degrades silently.
EVAL_OCR_MAX_PAGES_PER_TENDER=300   # ENV-9  · vision-OCR page ceiling per tender
EVAL_ARCHIVE_MAX_BYTES=524288000    # ENV-10 · upload archive size limit (500 MB) — a ZIP is untrusted input
EVAL_ARCHIVE_MAX_FILES=500          # ENV-11 · upload archive entry-count limit (zip-bomb bound)
EVAL_ATTRIBUTION_THRESHOLD=0.85     # ENV-12 · at/above this, a file is auto-attributed; below it goes to triage (F15-AC2)
EVAL_RULEPACK_PATH=services/evaluate-engine/rulepacks/gfr-2017-manuals-2022.v1.json
                                    # ENV-13 · versioned rulepack. MISSING → fail fast at startup (F23-ERR1);
                                    #          a silently rule-less draft workspace is the worst degradation here.
EVAL_SIGNAL_MIN_TENDERS=5           # ENV-14 · concluded tenders below which past-tender signal is SUPPRESSED (F24-AC2)
EVAL_REQUIRED_SIGNOFF_ROLES=legal,finance,technical
                                    # ENV-15 · roles whose sign-off blocks publish (F25-AC3)


# ─────────────────────────────────────────────────────────────────────────────
# DISCOVERY & TRACEABILITY (Modules F/G) — docs/discovery/PRD.md §9
#
# Same project, same database as the bidder product above — F and G are new modules
# inside apps/web + services/engine, not a new surface. No portal credential appears
# here or anywhere else: G-8 forbids authenticated acquisition outright, and a source
# that needs a login is served by the customer forwarding their own alert email (T3).
# ─────────────────────────────────────────────────────────────────────────────
DISCOVERY_INBOUND_DOMAIN=           # domain for per-workspace T3 addresses (tenders@<key>.<domain>)
DISCOVERY_INBOUND_SECRET=           # shared secret verifying the inbound-email webhook signature
DISCOVERY_USER_AGENT=               # G-10 · identified crawler UA — REQUIRED, no default
DISCOVERY_CONTACT_URL=              # G-10 · contact URL carried in the UA — REQUIRED, no default
DISCOVERY_MAX_RPS_PER_HOST=1        # G-10 · per-host rate cap
DISCOVERY_FETCH_BYTE_CAP=10485760   # G-10 · per-response byte cap (SSRF/abuse control)
DISCOVERY_POLL_INTERVAL_MIN=60      # base poll cadence; per-source override lives in the registry
DISCOVERY_TRIAGE_DAILY_CAP=50       # max Depth-1 NIT escalations per workspace per day (cost gate)

# ── Opportunity alerts (UML ask 1) ─────────────────────────────────────────────
# OPTIONAL. Unset, the engine runs normally and alerts report themselves as
# unavailable; a workspace that has switched alerts ON with these unset gets a
# named SMTP_NOT_CONFIGURED error rather than a silent "sent 0".
# Plain SMTP, no vendor: the domain already has email hosting, and every provider
# speaks it. Port 587 uses STARTTLS, anything else implicit TLS.
SMTP_HOST=                    # e.g. smtp.hostinger.com
SMTP_PORT=465                 # 465 implicit TLS | 587 STARTTLS
SMTP_USER=                    # the mailbox that authenticates AND sends
SMTP_PASSWORD=                # mailbox password — never committed
SMTP_FROM=                    # optional; defaults to SMTP_USER, which keeps SPF/DKIM aligned
SMTP_FROM_NAME=TenderCraft
APP_URL=                      # public web URL used for deep links inside alert emails

# ---- scheduled jobs (UML asks 1 and 4) --------------------------------------
# The digest and the stage watcher run with no user behind them, so /internal/cron/*
# authenticates Google's per-invocation OIDC token instead of a Supabase session.
# There is no secret here to rotate or leak — only two facts about who may call.
# BOTH unset means every cron call is refused (fails closed); a deployment missing
# these has no scheduled jobs, never an open unauthenticated endpoint.
CRON_AUDIENCE=                 # this engine's own public URL, exactly as the job's OIDC audience
CRON_SERVICE_ACCOUNTS=         # comma-separated service-account emails allowed to call

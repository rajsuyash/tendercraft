# Copy to .env and fill. App fails fast on missing required vars.
# Names only — never commit values.

# Supabase (web uses the publishable key; engine uses the secret/service key — never expose it to web)
NEXT_PUBLIC_SUPABASE_URL=          # Supabase project URL — web + engine
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # publishable key (sb_publishable_…) — web client
SUPABASE_SERVICE_ROLE_KEY=         # secret key (sb_secret_…) — engine, RLS-bypassing ops
SUPABASE_DB_URL=                   # direct Postgres URL — only if bypassing PostgREST
SUPABASE_ACCESS_TOKEN=             # PAT (sbp_…) — migrations via Management API (dev/CI only)
SUPABASE_ANON_JWT=                 # legacy anon JWT — auth admin + isolation tests (every API accepts it)
SUPABASE_SERVICE_JWT=              # legacy service_role JWT — auth admin API (new secret key is rejected there)

# LLM
ANTHROPIC_API_KEY=                 # Claude API — pipeline components (extractor/drafter/matcher/translator)

# OCR — TODO: choose provider (Document AI vs Textract vs Surya), then replace with its real vars
OCR_PROVIDER=                      # e.g. "documentai" | "textract" — gates A-FR1/A-FR6
OCR_API_CREDENTIALS=               # provider credential reference (path or key name)

# Service wiring
ENGINE_URL=                        # web → engine base URL (http://localhost:8000 in dev)
ENGINE_JWT_SECRET=                 # engine validates Supabase JWTs (Supabase JWT secret)

# Storage
DOCUMENTS_BUCKET=tender-documents  # Supabase Storage bucket for tender packages + library docs

# Optional
SENTRY_DSN=                        # error reporting (leave empty to disable)
